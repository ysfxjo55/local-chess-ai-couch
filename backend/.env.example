# Required in production: generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`
APP_ENV=production
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=60
JWT_ISSUER=chess-coach
JWT_AUDIENCE=chess-coach-web
DATABASE_URL=sqlite:////absolute/path/to/app.db

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=https://chess.ysfxjo.com
TRUSTED_HOSTS=chess.ysfxjo.com,api.ysfxjo.com
MAX_REQUEST_BYTES=65536

# Optional registration/legacy-account controls. Set a random value before
# exposing account creation or claiming a legacy quick-start account.
REGISTRATION_CODE=
ACCOUNT_CLAIM_CODE=

STOCKFISH_PATH=/usr/games/stockfish
ENGINE_ANALYSIS_SECONDS=0.20
PUZZLE_ENGINE_SECONDS=0.25
LC0_PATH=/path/to/lc0
MAIA_WEIGHTS_DIR=/path/to/maia_weights
SPARRING_SESSION_TTL_MINUTES=30
MAX_ACTIVE_SPARRING_SESSIONS=1

LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
COACH_MAX_MESSAGE_CHARS=4000
COACH_HISTORY_LIMIT=24
